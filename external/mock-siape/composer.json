{
    "name": "mock/siape",
    "description": "Mock SIAPE API for local testing",
    "type": "project",
    "autoload": {
        "psr-4": {
            "MockSiape\\": "src/",
            "MockSiape\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.0",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "ext-simplexml": "*",
        "ext-dom": "*",
        "ext-curl": "*"
    },
    "scripts": {
        "serve": "php -S localhost:8080 -t public",
        "test": "php tests/run-e2e.php",
        "seed": "php -r \"require 'bootstrap.php'; (new MockSiape\\Database\\Seeder())->run();\""
    }
}
